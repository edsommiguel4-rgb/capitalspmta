{
  "name": "gta5-forum-portal",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",

    "start": "sh -c 'echo ⏳ DB && for i in $(seq 1 15); do npx prisma db push && break || sleep 3; done && echo ✅ DB OK && npx prisma generate && node prisma/seed.js || true && echo 🚀 START && next start -p $PORT'",

    "lint": "next lint",

    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "nodemailer": "^8.0.0",
    "zod": "^3.23.8"
  }
}
